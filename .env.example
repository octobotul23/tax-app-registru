# ---------------------------------------------------------------------------
# Copy to `.env` and edit before the first `docker compose up`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me-before-you-deploy
POSTGRES_DB=ledger
# Host port for poking at the DB with psql/pgAdmin. Bound to localhost only.
POSTGRES_PORT=5432

# --- Security -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-real-one-do-not-ship-this
# How long a login lasts before re-authentication is required.
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# --- Bootstrap owner account ---------------------------------------------
# Created automatically on first startup, only if the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
BOOTSTRAP_ADMIN_NAME=Owner

# --- Money ----------------------------------------------------------------
# Everything is reported in this currency. Receipts may be in any of
# SUPPORTED_CURRENCIES and are converted using the rates you set in Settings.
BASE_CURRENCY=RON
SUPPORTED_CURRENCIES=RON,EUR,USD

# --- Local AI (Ollama) ----------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# Vision model used to read receipt photographs.
#   qwen2.5vl:7b  ~6 GB VRAM  - best accuracy/size tradeoff, good with Romanian
#   qwen2.5vl:3b  ~3 GB VRAM  - for smaller GPUs or CPU-only
#   llama3.2-vision:11b ~8 GB - alternative, weaker on non-English receipts
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Seconds to wait for one scan before giving up. Vision models are slow on CPU.
OLLAMA_TIMEOUT_SECONDS=300

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_MB=25
# Photos are downscaled to this longest edge before being stored and scanned.
IMAGE_MAX_EDGE=1800

# --- Worker ---------------------------------------------------------------
# How often the scan worker looks for newly uploaded documents.
WORKER_POLL_SECONDS=5
# Give up on a document after this many failed scan attempts.
WORKER_MAX_ATTEMPTS=3

# --- Web ------------------------------------------------------------------
# Port the whole app is served on.
WEB_PORT=8080
